function gate(){
 const hasSalary=$('hasSalary').value;
 $('salaryQuestions').hidden=hasSalary!=='yes';
 const outside=hasSalary==='yes'&&$('salaryDeposit').value==='other';
 $('threeMonthRow').hidden=!outside;
 if(!outside)$('threeMonthDeposit').value='';
 const answer=$('threeMonthDeposit').value;
 const blocked=hasSalary!=='yes'||(outside&&answer!=='yes');
 $('calculationArea').hidden=blocked;
 $('resultsPanel').hidden=blocked;
 $('eligibilityNotice').hidden=!blocked;
 if(blocked){
  const noSalary=hasSalary==='no';
  const denied=noSalary||(outside&&answer==='no');
  $('eligibilityNotice').textContent=denied?gateText[lang].no:(hasSalary!== 'yes'?(lang==='ar'?'يرجى تحديد هل لديك راتب.':'Please confirm whether you receive a salary.'):gateText[lang].pending);
 }

async function evaluate(showErrors){
  reveal();updateCards();
  const d=inputData();
  const seq=++requestSequence;
  if(activeController){activeController.abort();activeController=null;}
  if(!gate()){resetResults(null);return;}
  if(!showErrors&&(!d.salary||!d.salaryDeposit||!d.employment)){
    resetResults(null);return;
  }
  // Keep incomplete input local. Submit only when the required fields are present.
  if(!d.salary||!d.salaryDeposit||!d.employment){
    resetResults(!d.salary?'salary':'details');return;
  }
  const housing=d.inside.RF.some(v=>Number(v)>0);
  if(housing&&!d.supported){resetResults('supported');return;}
  if(housing&&d.supported==='yes'&&!d.subsidyType){resetResults('subsidyType');return;}
  if(housing&&d.supported==='yes'&&d.subsidyType==='monthly'&&!(Number(d.monthlySubsidy)>0)){
    resetResults('subsidyAmount');return;
  }
  const controller=new AbortController();activeController=controller;
  try{
    const response=await fetch(WORKER_URL,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(d),
      signal:controller.signal,
      cache:'no-store'
    });
    const result=await response.json();
    if(seq!==requestSequence)return;
    if(!response.ok||!result.valid){resetResults(result.reason||'network');return;}
    render(result);
  }catch(err){
    if(seq!==requestSequence||err.name==='AbortError')return;
    resetResults('network');
  }finally{
    if(activeController===controller)activeController=null;
  }
}

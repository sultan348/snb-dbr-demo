<div class="top-strip"></div>
<header class="app-header"><div class="container nav-row"><div class="brand"><span class="brand-emblem" aria-hidden="true">SA-alahmadi</span><div class="brand-words"><strong data-t="bankTitle">البنك السعودي</strong><small data-t="toolTitle">حاسبة نسبة الاستقطاع</small></div></div><div class="header-tools"><span class="mini-chip" data-t="preliminary">أداة تقييم أولي</span><button class="lang-switch" id="languageBtn" type="button">English ↔</button></div></div></header>
<main class="container main-grid"><section class="workspace">
<div class="welcome"><p class="eyebrow" data-t="welcomeEyebrow">تحليل الالتزامات البنكية</p><h1 data-t="heading">تقييم نسبة الاستقطاع وإعادة الجدولة</h1><p class="author-credit" data-t="authorCredit">بواسطة سلطان الأحمدي-0503489883</p><p data-t="intro">أدخل البيانات للحصول على تقييم استرشادي فوري.</p></div>
<form id="dbrForm" autocomplete="off" novalidate>
<div class="panel"><div class="panel-title"><div class="step">01</div><div><h2 data-t="basicHeading">بيانات الدخل</h2><p data-t="basicHelp">حدد الراتب والحالة الوظيفية</p></div></div><div class="fields-grid">
<label class="field field-wide"><span id="hasSalaryLabel">هل لديك راتب؟</span><select id="hasSalary"><option value="">اختر...</option><option value="yes">نعم</option><option value="no">لا</option></select></label>
<div id="salaryQuestions" class="fields-grid field-wide" style="grid-template-columns:subgrid;grid-column:1/-1" hidden>
<label class="field"><span data-t="salaryLocation">جهة إيداع الراتب</span><select id="salaryDeposit" required><option value="" data-t="choose">اختر...</option><option value="at_snb" data-t="inBank">داخل البنك</option><option value="other" data-t="outBank">خارج البنك</option></select></label>
<label class="field"><span data-t="employment">الحالة الوظيفية</span><select id="employment" required><option value="" data-t="choose">اختر...</option><option value="salaried" data-t="salaried">موظف</option><option value="retired" data-t="retired">متقاعد</option></select></label>
<label class="field field-wide"><span data-t="monthlyIncome">الراتب الشهري</span><div class="input-with-unit"><input id="salary" type="number" inputmode="decimal" step="0.01" min="0" required placeholder="0"><span data-t="currency">ر.س</span></div></label>
<label class="field field-wide" id="threeMonthRow" hidden><span id="threeMonthLabel">هل تم إيداع الراتب خلال الأشهر الثلاثة الأخيرة؟</span><select id="threeMonthDeposit"><option value="">اختر...</option><option value="yes">نعم</option><option value="no">لا</option></select></label>
</div></div></div>
<div id="eligibilityNotice" class="panel" hidden role="status" aria-live="polite"></div>
<div id="calculationArea">
<div class="panel"><div class="panel-title"><div class="step">+</div><div><h2 data-t="livingHeading"></h2><p data-t="livingHelp"></p></div></div><div class="fields-grid">
<label class="field"><span data-t="dependents"></span><input id="dependents" type="number" min="0" step="1" inputmode="numeric" placeholder="0"></label>
<label class="field"><span data-t="housing"></span><select id="livingHousing"><option value="" data-t="choose"></option><option value="owned" data-t="owned"></option><option value="rented" data-t="rented"></option><option value="family" data-t="family"></option><option value="provided" data-t="provided"></option></select></label>
<label class="field" id="rentRow" hidden><span data-t="rent"></span><div class="input-with-unit"><input id="living_rent" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label><label class="field" ><span data-t="maid"></span><div class="input-with-unit"><input id="living_maid" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label><label class="field" ><span data-t="driver"></span><div class="input-with-unit"><input id="living_driver" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label><label class="field" ><span data-t="insurance"></span><div class="input-with-unit"><input id="living_insurance" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label><label class="field" ><span data-t="alimony"></span><div class="input-with-unit"><input id="living_alimony" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label><label class="field" ><span data-t="personalFamilyLoans"></span><div class="input-with-unit"><input id="living_personalFamilyLoans" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label><label class="field" ><span data-t="future"></span><div class="input-with-unit"><input id="living_future" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label><label class="field" ><span data-t="other"></span><div class="input-with-unit"><input id="living_other" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"><span data-t="currency"></span></div></label></div></div>
<div class="panel"><div class="panel-title"><div class="step">02</div><div><h2 data-t="insideHeading">منتجات التمويل لدى البنك</h2><p data-t="insideHelp">أدخل القسط الشهري أو حد البطاقة الائتمانية لكل منتج</p></div></div><div class="facility-grid"><div class="facility" id="inside-PF" data-facility="PF"></div>
<div class="facility" id="inside-RF" data-facility="RF"></div>
<div class="facility" id="inside-AL" data-facility="AL"></div>
<div class="facility" id="inside-CC" data-facility="CC"></div></div></div>
<div id="supportPanel" class="panel" hidden><div class="panel-title"><div class="step">03</div><div><h2 data-t="supportHeading">هل التمويل العقاري مدعوم من صندوق التنمية العقاري؟</h2><p data-t="supportHelp">تظهر الأسئلة في حال وجود تمويل عقاري</p></div></div>
<div class="support-basics"><label class="field"><span data-t="supportHeading">هل التمويل العقاري مدعوم؟</span><select id="supported"><option value="" data-t="choose">اختر...</option><option value="yes" data-t="yes">نعم</option><option value="no" data-t="no">لا</option></select></label>
<label class="field" id="supportTypeRow" hidden><span data-t="supportType">نوع الدعم</span><select id="subsidyType"><option value="" data-t="choose">اختر...</option><option value="monthly" data-t="monthly">شهري</option><option value="upfront" data-t="upfront">مقدم</option></select></label></div>
<div class="support-subfields"><label class="field" id="supportAmountRow" hidden><span data-t="supportAmount">مبلغ الدعم الشهري</span><div class="input-with-unit"><input id="monthlySubsidy" type="number" min="0" step="0.01" inputmode="decimal" value="0"><span data-t="currency">ر.س</span></div></label></div>
<div class="extra-note" id="housingBasisRow" hidden><span data-t="housingBasis">الدخل المحتسب للتمويل العقاري</span>: <strong id="housingIncomePreview">—</strong> · <span data-t="salaryBasis">الدخل المحتسب لبقية المنتجات</span>: <strong id="salaryIncomePreview">—</strong></div>
</div>
<div class="panel" id="outsidePanel" hidden><div class="panel-title"><div class="step">04</div><div><h2 data-t="outsideHeading">منتجات البنوك الأخرى</h2><p data-t="outsideHelp">تظهر عند إيداع الراتب خارج البنك</p></div></div><p class="section-subheading" data-t="productNotice">هذا الجزء للمنتجات الاستهلاكية فقط</p><div class="facility-grid"><div class="facility" id="outside-PF" data-facility="PF"></div>
<div class="facility" id="outside-RF" data-facility="RF"></div>
<div class="facility" id="outside-AL" data-facility="AL"></div>
<div class="facility" id="outside-CC" data-facility="CC"></div></div></div>

